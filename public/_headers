# Always revalidate the entry point and the service worker so new deploys are
# picked up promptly; hashed assets under /assets are immutable and long-cached.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
